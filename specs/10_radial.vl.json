{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 10. Radial (polar area) small multiples: each month is an equal wedge; wedge length = share of the group's records, 2021-2025.",
  "data": {
    "url": "data/month_group.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month": "number",
        "records": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "records",
          "as": "total"
        }
      ],
      "groupby": [
        "group"
      ]
    },
    {
      "calculate": "datum.records / datum.total",
      "as": "share"
    },
    {
      "calculate": "datum.month - 1",
      "as": "start"
    },
    {
      "calculate": "datum.month",
      "as": "end"
    },
    {
      "calculate": "['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][datum.month - 1]",
      "as": "monthName"
    }
  ],
  "facet": {
    "field": "group",
    "type": "nominal",
    "title": null,
    "sort": [
      "Birds",
      "Frogs",
      "Insects",
      "Reptiles",
      "Fungi"
    ],
    "header": {
      "labelFontSize": 15,
      "labelFontWeight": "bold"
    }
  },
  "columns": 5,
  "spec": {
    "width": 150,
    "height": 150,
    "layer": [
      {
        "description": "Wedges: one per month (equal angle); length = share of the group's records",
        "params": [
          {
            "name": "m",
            "select": {
              "type": "point",
              "fields": [
                "month"
              ],
              "on": "pointerover",
              "clear": "pointerout"
            }
          }
        ],
        "mark": {
          "type": "arc",
          "stroke": "#FFFFFF"
        },
        "encoding": {
          "theta": {
            "field": "start",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                12
              ]
            }
          },
          "theta2": {
            "field": "end"
          },
          "radius": {
            "field": "share",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "zero": true,
              "rangeMax": 66
            }
          },
          "color": {
            "field": "group",
            "type": "nominal",
            "scale": {
              "domain": [
                "Birds",
                "Frogs",
                "Insects",
                "Reptiles",
                "Fungi",
                "Mammals",
                "Plants",
                "Other animals"
              ],
              "range": [
                "#0072B2",
                "#009E73",
                "#E69F00",
                "#8A6A36",
                "#CC79A7",
                "#7B68A6",
                "#97A33C",
                "#9FB3C2"
              ]
            },
            "legend": null
          },
          "opacity": {
            "condition": {
              "param": "m",
              "value": 1
            },
            "value": 0.3
          },
          "tooltip": [
            {
              "field": "group"
            },
            {
              "field": "monthName",
              "title": "Month"
            },
            {
              "field": "share",
              "format": ".1%"
            }
          ]
        }
      },
      {
        "description": "Month names around each circle",
        "transform": [
          {
            "calculate": "datum.month - 0.5",
            "as": "middle"
          }
        ],
        "mark": {
          "type": "text",
          "radius": 76,
          "fontSize": 10,
          "color": "#56645C"
        },
        "encoding": {
          "theta": {
            "field": "middle",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                12
              ]
            }
          },
          "text": {
            "field": "monthName"
          }
        }
      }
    ]
  }
}
